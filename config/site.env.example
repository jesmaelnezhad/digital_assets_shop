# Copy to config/site.env and fill in. This is the only identity file.
# Secrets go in config/site.secrets.env (gitignored).

BLUE_HOST=203.0.113.10
BLUE_SSH_PORT=22
BLUE_SSH_USER=root
RED_HOST=203.0.113.20
RED_SSH_PORT=22
RED_SSH_USER=root

STAGING_HOST=staging.example.com
PRODUCTION_HOST=example.com

REPO_DIR=/root/digital_assets_shop

INGRESS_HTTP_NODEPORT=30758
INGRESS_NGINX_IMAGE=registry.k8s.io/ingress-nginx/controller:v1.11.2
REGISTRY_HOST=${STAGING_HOST}
REGISTRY_PULL_USER=k3s-pull
REGISTRY_PUSH_USER=registry-push
IMAGE_REPO=store4bots

DB_HOST=${RED_HOST}
DB_PORT=5432
DB_USER=app
MONGO_HOST=${RED_HOST}
MONGO_PORT=27017
MONGO_USER=paw
MONGO_DB=events

K3S_DISABLE=traefik
STAGING_NS=staging
PRODUCTION_NS=production
REGISTRY_NS=registry
INGRESS_NS=ingress-nginx
