# Store4bots site identity — THE only file that holds this install's hosts.
# Copy config/site.env.example to config/site.env for a new pair of servers.
# Docs and scripts use the names on the left. Do not paste these values elsewhere.
#
# Secrets (passwords, tokens, htpasswd) belong in config/site.secrets.env
# which is gitignored. See config/site.secrets.env.example.

# --- servers ---
BLUE_HOST=130.185.121.83
BLUE_SSH_PORT=2222
BLUE_SSH_USER=root
RED_HOST=130.185.123.156
RED_SSH_PORT=22
RED_SSH_USER=root

# --- domains (A records must point at RED_HOST) ---
STAGING_HOST=server-ad5ae8ea-5132-4cd3-b11f-5cb0f43bdc53.eu-west1-a.arvancompute.ir
PRODUCTION_HOST=store4bots.xyz

# --- paths ---
REPO_DIR=/root/digital_assets_shop

# --- ingress / registry ---
INGRESS_HTTP_NODEPORT=30758
# Stock ingress-nginx. This cluster also has a Hub copy tagged
# ${REGISTRY_HOST}/store4bots-ingress-nginx:v1.11.2 if registry.k8s.io is blocked.
INGRESS_NGINX_IMAGE=registry.k8s.io/ingress-nginx/controller:v1.11.2
REGISTRY_HOST=${STAGING_HOST}
REGISTRY_PULL_USER=k3s-pull
REGISTRY_PUSH_USER=registry-push
IMAGE_REPO=store4bots

# --- host databases on RED (not in-cluster) ---
DB_HOST=${RED_HOST}
DB_PORT=5432
DB_USER=app
MONGO_HOST=${RED_HOST}
MONGO_PORT=27017
MONGO_USER=paw
MONGO_DB=events

# --- k8s ---
K3S_DISABLE=traefik
STAGING_NS=staging
PRODUCTION_NS=production
REGISTRY_NS=registry
INGRESS_NS=ingress-nginx
