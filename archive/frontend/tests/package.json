{
  "name": "pawradise-frontend-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "moduleFileExtensions": ["js", "html"],
    "testMatch": ["**/*.test.js"],
    "collectCoverageFrom": ["public/**/*.html"],
    "coverageThreshold": {
      "global": {
        "lines": 50,
        "statements": 50,
        "functions": 50,
        "branches": 50
      }
    }
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jsdom": "^22.1.0"
  }
}
